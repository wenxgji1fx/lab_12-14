<Window x:Class="PhoneBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Телефонная книга"
        Height="560"
        MinHeight="440"
        MinWidth="860"
        Width="940"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#162033" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Телефонная книга"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="12,0,0,0">
                            <Button Content="Новый"
                                    Command="{Binding NewContactCommand}" />
                            <Button Content="Обновить"
                                    Command="{Binding RefreshCommand}" />
                            <Button Content="Удалить"
                                    Command="{Binding DeleteContactCommand}"
                                    Margin="0" />
                        </StackPanel>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по имени или телефону" />
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Contacts}"
                              SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              AlternatingRowBackground="#F7F9FC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id"
                                                Binding="{Binding Id}"
                                                Width="60" />
                            <DataGridTextColumn Header="Имя"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="Телефон"
                                                Binding="{Binding Phone}"
                                                Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Editor.FormTitle}"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="2"
                               Text="Имя"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="4"
                             Text="{Binding Editor.NameInput, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="6">
                        <TextBlock Text="Телефон"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding Editor.PhoneInput, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Editor.PrimaryActionText}"
                                    Command="{Binding Editor.SaveCommand}" />
                            <Button Content="Очистить"
                                    Command="{Binding Editor.ClearCommand}"
                                    Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Editor.StatusMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="#48566A"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Foreground="#48566A" />
    </Grid>
</Window>
